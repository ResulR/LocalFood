# Server runtime environment.
NODE_ENV=development

# Express server port.
PORT=4000

# Allowed frontend origin for CORS.
# Local development example: http://localhost:5173
# Production example: https://your-domain.example
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Local JWT authentication.
# Must be at least 32 characters.
LOCAL_AUTH_JWT_SECRET=
LOCAL_AUTH_JWT_EXPIRES_IN=1d

# OpenAI assistant.
# Optional: if empty, the AI route should use its fallback behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily AI request limit per IP.
AI_DAILY_REQUEST_LIMIT=20
